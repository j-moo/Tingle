erDiagram
    chat_rooms {
        bigint chat_room_id PK
        bigint pair_id
        timestamptz created_at
        timestamptz expires_at
        timestamptz closed_at
        timestamptz delete_at
        bigint last_sequence
    }
    chat_members {
        bigint chat_room_id PK
        bigint user_id PK
        timestamptz left_at
        timestamptz first_notice_acked_at
        timestamptz end_notice_acked_at
    }
    chat_messages {
        bigint message_id PK
        bigint chat_room_id
        bigint sender_id
        uuid client_message_id
        bigint sequence
        text body
        timestamptz created_at
    }
    user_blocks {
        bigint block_id PK
        bigint blocker_id
        bigint blocked_id
        timestamptz created_at
    }
    reports {
        bigint report_id PK
        bigint reporter_id
        text target_type
        bigint target_id
        text reason
        text detail
        text status
        timestamptz created_at
    }
    ai_results {
        bigint job_id PK
        text kind
        bigint user_id
        bigint target_id
        jsonb result_json
        text model_version
        text prompt_version
        timestamptz created_at
    }
    push_installations {
        bigint installation_id PK
        uuid client_installation_id
        bigint user_id
        text platform
        text token_ciphertext
        timestamptz updated_at
    }
    background_jobs {
        bigint job_id PK
        text job_type
        text business_key
        jsonb payload
        text status
        timestamptz run_at
        integer attempts
        timestamptz lease_until
        text last_error_code
        jsonb result_json
        timestamptz finished_at
    }
    chat_rooms ||--o{ chat_members : "chat_room_id logical"
    chat_rooms ||--o{ chat_messages : "chat_room_id logical"
    background_jobs ||--o{ ai_results : "job_id logical"
