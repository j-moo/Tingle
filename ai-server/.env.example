APP_ENV=local
HOST=127.0.0.1
PORT=8000
# Required in every environment; supply the real value locally, never commit it.
GMS_API_KEY=
# APP_ENV still selects the service JWT issuer/audience.
AI_SERVICE_PUBLIC_KEYS={}
# Icebreaker keeps its existing Release registration. Match explanations need no descriptor.
ICEBREAKER_RELEASE_DESCRIPTOR_FILE=
