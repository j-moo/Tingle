# nginx 컨테이너가 시작할 때 ${DOMAIN} 을 .env 값으로 바꿔 /etc/nginx/conf.d/default.conf 로 만든다.
# upstream 은 변수로 둔다: 아직 없는 컨테이너(back 등)가 있어도 nginx 가 뜨고, 요청이 올 때 이름을 찾는다.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    resolver 127.0.0.11 valid=10s;
    client_max_body_size 20m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # 운영 — back 은 블루-그린. 상태 파일(infra/deploy-bluegreen.sh 가 씀)이 있으면 그 색, 없으면 blue
    location /api/ {
        set $up back-blue:8080;
        include /etc/nginx/state/back*.conf;
        proxy_pass http://$up;
    }
    location /ws/ {
        set $up back-blue:8080;
        include /etc/nginx/state/back*.conf;
        proxy_pass http://$up;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
    location / {
        set $up web:80;
        proxy_pass http://$up;
    }

    # 개발 — /dev 접두사를 떼고 -dev 컨테이너로 넘긴다
    location = /dev {
        return 301 /dev/;
    }
    location /dev/api/ {
        set $up back-dev:8080;
        rewrite ^/dev(/.*)$ $1 break;
        proxy_pass http://$up;
    }
    location /dev/ws/ {
        set $up back-dev:8080;
        rewrite ^/dev(/.*)$ $1 break;
        proxy_pass http://$up;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
    location /dev/ {
        set $up web-dev:80;
        rewrite ^/dev(/.*)$ $1 break;
        proxy_pass http://$up;
    }

    # Jenkins 는 --prefix=/jenkins 로 떠서 접두사를 그대로 넘긴다
    location /jenkins/ {
        set $up jenkins:8080;
        proxy_pass http://$up;
        proxy_request_buffering off;
    }
}

# 내부망 전용 — back 이 http://ai:8000 으로 부르면(ai 는 nginx 의 네트워크 별칭) 운영 색 ai-blue · ai-green 으로 넘긴다. 호스트에 열지 않는다.
server {
    listen 8000;
    resolver 127.0.0.11 valid=10s;
    proxy_http_version 1.1;
    proxy_read_timeout 120s; # GMS 호출이 길 수 있다

    location / {
        set $up ai-blue:8000;
        include /etc/nginx/state/ai*.conf;
        proxy_pass http://$up;
    }
}
