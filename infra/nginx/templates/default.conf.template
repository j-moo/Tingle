# nginx 컨테이너가 시작할 때 ${DOMAIN} 을 .env 값으로 바꿔 /etc/nginx/conf.d/default.conf 로 만든다.
# upstream 은 변수로 둔다: 아직 없는 컨테이너(back 등)가 있어도 nginx 가 뜨고, 요청이 올 때 이름을 찾는다.

# 접근 로그는 JSON 한 줄. Loki 에서 응답 시간(rt, 초)·상태 코드로 Grafana 그래프를 그린다.
# uri 는 rewrite 전 원래 경로(/dev/api/... 그대로)에서 쿼리 문자열을 뺀 값 — 토큰·개인정보가 로그에 남지 않게.
map $request_uri $log_path {
    ~^(?<p>[^?]*) $p;
}
log_format tingle escape=json '{"status":$status,"method":"$request_method","uri":"$log_path","rt":$request_time,"bytes":$body_bytes_sent,"upstream":"$upstream_addr","ua":"$http_user_agent"}';
# back → ai 내부 호출(8000)은 경로 앞에 /ai 를 붙여 남긴다 — 대시보드에서 /ai/.* 로 따로 본다
log_format tingle_ai escape=json '{"status":$status,"method":"$request_method","uri":"/ai$log_path","rt":$request_time,"bytes":$body_bytes_sent,"upstream":"$upstream_addr"}';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    resolver 127.0.0.11 valid=10s;
    client_max_body_size 20m;
    access_log /var/log/nginx/access.log tingle;

    # 공통 헤더. location 에 proxy_set_header 를 하나라도 쓰면 여기 값이 상속되지 않으므로 WebSocket 헤더도 여기서 함께 넘긴다
    # (일반 요청은 $connection_upgrade 가 close). 2026-10-27 Grafana 가 Host 를 grafana:3000 으로 받아 "origin not allowed" 로 로그인 실패한 원인.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # 운영 — back 은 블루-그린. 상태 파일(infra/deploy-bluegreen.sh 가 씀)이 있으면 그 색, 없으면 blue
    location /api/ {
        set $up back-blue:8080;
        include /etc/nginx/state/back*.conf;
        proxy_pass http://$up;
    }
    location /ws/ {
        set $up back-blue:8080;
        include /etc/nginx/state/back*.conf;
        proxy_pass http://$up;
        proxy_read_timeout 3600s;
    }
    location / {
        set $up web:80;
        proxy_pass http://$up;
    }

    # Android App Links — 네이버 로그인(OIDC) 콜백 https://${DOMAIN}/auth/naver/callback(운영 앱) · /dev/auth/naver/callback(개발 앱)을
    # 브라우저 대신 앱이 받게 한다. 패키지 2개 × 서명 키 2개: 운영 tingle-release.jks(Jenkins APK) · 팀 공용 디버그 키(front/app/tingle-debug.keystore, 로컬 빌드)
    location = /.well-known/assetlinks.json {
        default_type application/json;
        add_header Cache-Control "max-age=300";
        return 200 '[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"com.ssafy.tingle","sha256_cert_fingerprints":["DA:56:86:05:32:B1:3D:4F:B0:76:EF:07:CD:8A:BE:0F:AB:FB:7C:8E:F9:C1:7C:BB:B7:F8:E7:76:0B:80:54:4A","45:E7:2E:2F:51:C1:F4:0F:25:77:9E:27:B3:EE:17:0B:81:C1:E8:71:51:E3:C4:AB:D1:AE:73:38:43:B6:B1:34"]}},{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"com.ssafy.tingle.dev","sha256_cert_fingerprints":["DA:56:86:05:32:B1:3D:4F:B0:76:EF:07:CD:8A:BE:0F:AB:FB:7C:8E:F9:C1:7C:BB:B7:F8:E7:76:0B:80:54:4A","45:E7:2E:2F:51:C1:F4:0F:25:77:9E:27:B3:EE:17:0B:81:C1:E8:71:51:E3:C4:AB:D1:AE:73:38:43:B6:B1:34"]}}]';
    }

    # 개발 — /dev 접두사를 떼고 -dev 컨테이너로 넘긴다
    location = /dev {
        return 301 /dev/;
    }
    location /dev/api/ {
        set $up back-dev:8080;
        rewrite ^/dev(/.*)$ $1 break;
        proxy_pass http://$up;
    }
    location /dev/ws/ {
        set $up back-dev:8080;
        rewrite ^/dev(/.*)$ $1 break;
        proxy_pass http://$up;
        proxy_read_timeout 3600s;
    }
    # 개발 APK — 개발 서버 주소 규칙(/dev/...)에 맞춘다. 파일은 Jenkins 가 develop 머지 때 /srv/tingle/app/dev/latest.apk 로 쓴다.
    # 첨부파일로 내려줘 받은 파일 이름을 구분하고 브라우저가 다운로드로 처리하게 한다.
    location /dev/app/ {
        alias /srv/tingle/app/dev/;
        types {
            application/vnd.android.package-archive apk;
        }
        add_header Cache-Control no-cache; # 같은 이름으로 덮어쓰므로 항상 새로 확인
        add_header Content-Disposition 'attachment; filename="tingle-dev.apk"';
    }
    location /dev/ {
        set $up web-dev:80;
        rewrite ^/dev(/.*)$ $1 break;
        proxy_pass http://$up;
    }

    # 운영 APK — Jenkins 가 master 머지 때 /srv/tingle/app/latest.apk 로 쓴다.
    # 개발 APK 폴더도 /srv/tingle/app/dev/ 안에 있어 /app/ 로 열리므로 막는다 — 개발 APK 주소는 /dev/app/ 만 쓴다 (2026-10-28)
    location /app/dev/ {
        return 404;
    }
    location /app/ {
        alias /srv/tingle/app/;
        types {
            application/vnd.android.package-archive apk;
        }
        add_header Cache-Control no-cache; # 같은 이름으로 덮어쓰므로 항상 새로 확인
        add_header Content-Disposition 'attachment; filename="tingle.apk"';
    }

    # Jenkins 는 --prefix=/jenkins 로 떠서 접두사를 그대로 넘긴다
    location /jenkins/ {
        set $up jenkins:8080;
        proxy_pass http://$up;
        proxy_request_buffering off;
    }

    # Grafana 는 /grafana/ 하위 경로로 떠서(GF_SERVER_SERVE_FROM_SUB_PATH) 접두사를 그대로 넘긴다
    location /grafana/ {
        set $up grafana:3000;
        proxy_pass http://$up;
    }
}

# 내부망 전용 — back 이 http://ai:8000 으로 부르면(ai 는 nginx 의 네트워크 별칭) 운영 색 ai-blue · ai-green 으로 넘긴다. 호스트에 열지 않는다.
server {
    listen 8000;
    resolver 127.0.0.11 valid=10s;
    access_log /var/log/nginx/access.log tingle_ai;
    proxy_http_version 1.1;
    proxy_read_timeout 120s; # GMS 호출이 길 수 있다

    location / {
        set $up ai-blue:8000;
        include /etc/nginx/state/ai*.conf;
        proxy_pass http://$up;
    }
}
