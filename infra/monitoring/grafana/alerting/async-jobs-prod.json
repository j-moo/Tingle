{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "tingle_async_jobs_prod",
      "folder": "Tingle production",
      "interval": "1m",
      "rules": [
        {
          "uid": "tingle-async-overdue-prod",
          "title": "TingleAsyncJobsOverdue",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 180,
                "to": 0
              },
              "datasourceUid": "loki",
              "model": {
                "refId": "A",
                "expr": "max by (service, stage) (last_over_time({service=~\"back-(blue|green)\"} |= \"event=async_jobs \" | regexp \"stage=(?P<stage>[a-z_]+).* overdue=(?P<value>[0-9]+)\" | unwrap value | __error__=\"\" [2m]))",
                "queryType": "instant",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                },
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {}
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Async work remains past its recorded due time"
          },
          "labels": {
            "severity": "warning",
            "environment": "prod",
            "service": "back",
            "scope": "async-jobs"
          },
          "isPaused": true
        },
        {
          "uid": "tingle-async-invalid-prod",
          "title": "TingleAsyncJobsInvalid",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "instant",
