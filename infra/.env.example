# 서버 /srv/tingle/.env 로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.
# 여기에는 Jenkins 를 띄우는 데 필요한 값만 둔다 (손으로 관리).
# 앱 비밀값(DB 계정, 이후 JWT·GMS 키 등)은 Jenkins Credentials 에 넣고, Jenkins 가 develop 빌드마다 /srv/tingle/app.env 로 쓴다 (Jenkinsfile app-env 단계).
# GitLab 토큰도 Jenkins Credentials(gitlab-clone · gitlab-api)에만 있다.
# 빈 값(KEY=)은 기본값을 덮어쓰므로, 아직 안 쓰는 변수는 주석으로 둔다.

# nginx — 인증서 경로와 server_name
DOMAIN=k15e106.p.ssafy.io

# jenkins — 관리자 계정(설정 코드 infra/jenkins/casc 가 읽음)과 docker 소켓 권한
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# 서버에서 `getent group docker` 의 세 번째 값 (k15e106 은 988)
DOCKER_GID=988
# GitLab Webhook 의 Secret token 과 같은 값 (openssl rand -hex 24)
GITLAB_WEBHOOK_SECRET=

# grafana — 관리자 비밀번호 (/grafana/ 로그인, 계정 admin). 첫 기동 때만 적용된다 (openssl rand -hex 16)
GRAFANA_ADMIN_PASSWORD=
