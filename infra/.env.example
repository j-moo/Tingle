# 서버 /srv/tingle/.env 로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.
# 빈 값(KEY=)은 기본값을 덮어쓰므로, 아직 안 쓰는 변수는 주석으로 둔다.

# nginx — 인증서 경로와 server_name
DOMAIN=k15e106.p.ssafy.io

# db — 사용자 tingle 의 비밀번호 (운영 tingle · 개발 tingle_dev 공용)
POSTGRES_PASSWORD=

# back — 컨테이너가 생기면 사용 (back/.env.example 참고)
# JWT_SECRET=
# GOOGLE_WEB_CLIENT_ID=
# KAKAO_APP_ID=

# ai — 컨테이너가 생기면 사용
# GMS_API_KEY=
