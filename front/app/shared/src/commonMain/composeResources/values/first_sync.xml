<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="first_sync_title">키링 동기화</string>
    <string name="first_sync_disconnected_title">키링 연결을\n기다리고 있어요</string>
    <string name="first_sync_disconnected_body">아직 키링에 설정을 전달하지 못했어요. 등록한 키링의 전원을 켜고 휴대폰 가까이에 두세요. 연결되면 동기화를 시작해요.</string>
    <string name="first_sync_connect">키링 연결 확인</string>
    <string name="first_sync_connecting_title">키링에\n연결하고 있어요</string>
    <string name="first_sync_connecting_body">등록한 키링과 연결을 확인하고 있어요. 키링을 가까이에 두고 잠시 기다려 주세요.</string>
    <string name="first_sync_connecting">연결 중…</string>
    <string name="first_sync_preparing_title">최신 설정을\n준비하고 있어요</string>
    <string name="first_sync_preparing_body">저장한 성향 결과와 희망 조건, 매칭 설정을 확인하고 있어요.</string>
    <string name="first_sync_preparing">설정 준비 중…</string>
    <string name="first_sync_sending_title">키링에 설정을\n전달하고 있어요</string>
    <string name="first_sync_sending_body">나에게 맞는 만남을 찾을 수 있도록 저장한 설정을 키링에 전달하고 있어요.</string>
    <string name="first_sync_sending">설정 전달 중…</string>
    <string name="first_sync_applying_title">키링의 설정 적용을\n확인하고 있어요</string>
    <string name="first_sync_applying_body">설정 전달은 끝났어요. 키링에 정상적으로 저장되고 적용됐는지 확인하고 있어요.</string>
    <string name="first_sync_applying">적용 확인 중…</string>
    <string name="first_sync_account_title">마지막으로\n가입 완료를 확인해요</string>
    <string name="first_sync_account_body">키링에 최신 설정이 적용됐어요. 이제 가입 상태를 확인하고 있어요.</string>
    <string name="first_sync_checking">가입 확인 중…</string>
    <string name="first_sync_interrupted_title">키링 연결이\n끊어졌어요</string>
    <string name="first_sync_interrupted_body">현재 설정이 모두 적용됐는지 아직 확인할 수 없어요. 키링을 다시 연결하면 적용 상태를 확인하고 필요한 동기화를 이어가요.</string>
    <string name="first_sync_reconnect">키링 다시 연결</string>
    <string name="first_sync_failed_title">동기화를\n완료하지 못했어요</string>
    <string name="first_sync_failed_body">키링에 최신 설정을 적용하지 못했어요. 인터넷과 키링 연결을 확인한 뒤 다시 시도해 주세요.</string>
    <string name="first_sync_retry">동기화 다시 시도</string>
    <string name="first_sync_unknown_title">적용 결과를\n확인하지 못했어요</string>
    <string name="first_sync_unknown_body">응답을 받지 못해 키링에 설정이 적용됐는지 아직 알 수 없어요. 연결 상태를 확인하고 적용 결과를 다시 확인해 주세요.</string>
    <string name="first_sync_check_device">적용 상태 다시 확인</string>
    <string name="first_sync_account_failed_title">가입 완료 여부를\n확인하지 못했어요</string>
    <string name="first_sync_account_failed_body">인터넷 연결을 확인한 뒤 가입 상태를 다시 확인해 주세요.</string>
    <string name="first_sync_check_account">가입 상태 다시 확인</string>
    <string name="first_sync_applied_title">키링 설정 적용은 확인했어요</string>
    <string name="first_sync_applied_body">가입 완료 여부만 다시 확인하면 돼요. 프로필이나 설문을 다시 작성할 필요는 없어요.</string>
    <string name="first_sync_changed_title">설정이 변경돼\n다시 동기화가 필요해요</string>
    <string name="first_sync_changed_body">이전 설정의 적용 결과로는 준비 완료를 표시할 수 없어요. 가장 최근에 저장한 설정으로 동기화해 주세요.</string>
    <string name="first_sync_retry_latest">최신 설정 동기화</string>
    <string name="first_sync_complete_title">가입을 완료했어요</string>
    <string name="first_sync_complete_body">키링에 최신 설정이 적용됐어요. Tingle과 함께 자연스러운 만남을 시작해 보세요.</string>
    <string name="first_sync_complete_badge">동기화 완료</string>
    <string name="first_sync_matching_on">매칭이 켜져 있어요. 준비된 키링으로 주변의 인연을 만나보세요.</string>
    <string name="first_sync_matching_off">매칭이 꺼져 있어요. 새 만남을 찾으려면 홈에서 매칭을 켜 주세요.</string>
    <string name="first_sync_matching_unknown">현재 매칭 ON/OFF 상태는 홈에서 다시 확인해 주세요.</string>
    <string name="first_sync_complete_help">설정을 변경하면 키링에 다시 동기화해요. 이후 연결 상태와 매칭 설정은 홈에서 확인할 수 있어요.</string>
    <string name="first_sync_home">홈으로 이동</string>
    <string name="first_sync_help_title">준비가 끝나면 알려드릴게요</string>
    <string name="first_sync_help_body">키링에 최신 설정이 적용되고 가입 완료까지 확인돼야 처음 이용을 시작할 수 있어요. 기다리는 동안 프로필이나 설문을 다시 작성할 필요는 없어요.</string>
    <string name="first_sync_step_connect">1. 키링 연결</string>
    <string name="first_sync_step_send">2. 설정 준비·전달</string>
    <string name="first_sync_step_apply">3. 기기 적용 확인</string>
    <string name="first_sync_step_account">4. 가입 완료 확인</string>
    <string name="first_sync_step_done">확인 완료</string>
    <string name="first_sync_step_current">진행 중</string>
    <string name="first_sync_step_wait">대기 중</string>
</resources>
