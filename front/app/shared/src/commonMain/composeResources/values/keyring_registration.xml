<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="keyring_registration_title">키링 등록</string>
    <string name="keyring_ready_title">키링과 함께\n만남을 시작해요</string>
    <string name="keyring_ready_body">내 키링을 연결하고 나만의 프로필을 준비해 보세요.</string>
    <string name="keyring_prepare_title">키링을 준비해 주세요</string>
    <string name="keyring_prepare_body">1. 키링의 전원을 확인해 주세요.\n2. 버튼을 길게 눌러 등록 모드로 바꿔 주세요.\n3. 휴대폰 가까이에 두고 키링을 찾아 주세요.</string>
    <string name="keyring_one_only">지금은 계정당 키링 1개를 등록할 수 있어요. 연결이 끊긴 키링도 등록 수에 포함돼요.</string>
    <string name="keyring_search">키링 찾기</string>
    <string name="keyring_purchase">키링이 없어요 · 구매 안내</string>
    <string name="keyring_permission_title">키링을 찾으려면\n접근 권한이 필요해요</string>
    <string name="keyring_permission_body">주변 키링을 찾고 연결하기 위한 권한을 요청할게요. 이어서 표시되는 휴대폰 권한 안내를 확인해 주세요.</string>
    <string name="keyring_allow">권한 허용하기</string>
    <string name="keyring_denied_title">기기 접근 권한을\n확인해 주세요</string>
    <string name="keyring_denied_body">권한이 꺼져 있어 키링을 찾을 수 없어요. 휴대폰 설정에서 Tingle의 기기 탐색·연결에 필요한 권한을 허용해 주세요.</string>
    <string name="keyring_settings">앱 설정 열기</string>
    <string name="keyring_bluetooth_title">블루투스를\n켜 주세요</string>
    <string name="keyring_bluetooth_body">키링을 찾고 연결하려면 휴대폰의 블루투스가 켜져 있어야 해요.</string>
    <string name="keyring_bluetooth_settings">블루투스 설정 열기</string>
    <string name="keyring_searching_title">주변 키링을\n찾고 있어요</string>
    <string name="keyring_searching_body">등록 모드의 키링을 휴대폰 가까이에 두세요. 잠시만 기다려 주세요.</string>
    <string name="keyring_stop_search">탐색 중지</string>
    <string name="keyring_not_found_title">키링을 찾지\n못했어요</string>
    <string name="keyring_not_found_body">전원과 등록 모드를 확인하고 다시 시도해 주세요.</string>
    <string name="keyring_search_again">다시 찾기</string>
    <string name="keyring_found_title">키링을 찾았어요</string>
    <string name="keyring_found_body">등록할 키링을 선택해 주세요.</string>
    <string name="keyring_device_label">%1$s\n%2$s</string>
    <string name="keyring_found_help">주변에 여러 키링이 있다면 기기 식별 정보를 확인해 내 키링을 선택해 주세요. 아직 계정에 등록된 상태는 아니에요.</string>
    <string name="keyring_register">등록하기</string>
    <string name="keyring_confirm_title">이 키링을\n등록할까요?</string>
    <string name="keyring_confirm_body">등록하기 전에 계정 귀속 안내를 확인해 주세요.</string>
    <string name="keyring_ownership_title">주의! 이 계정에 귀속돼요</string>
    <string name="keyring_ownership_body">등록하면 이 키링은 현재 계정에 연결돼요.\n\n다른 사람에게 양도하려면 소유자 계정으로 로그인한 뒤 실물 키링을 초기화해야 해요. 초기화와 계정 연결 해제가 모두 완료돼야 다시 등록할 수 있어요.</string>
    <string name="keyring_ownership_accept">계정 귀속과 양도 전 초기화 안내를 확인했어요.</string>
    <string name="keyring_accept_register">동의하고 등록하기</string>
    <string name="keyring_choose_again">다른 키링 선택</string>
    <string name="keyring_registering_title">키링을\n등록하고 있어요</string>
    <string name="keyring_registering_body">키링을 가까이에 두고 잠시 기다려 주세요. 등록 결과를 확인하고 있어요.</string>
    <string name="keyring_registering">등록 중…</string>
    <string name="keyring_checking_title">등록 상태를\n확인하고 있어요</string>
    <string name="keyring_checking_body">키링이 이 계정에 정상적으로 등록됐는지 확인하고 있어요.</string>
    <string name="keyring_checking">확인 중…</string>
    <string name="keyring_uncertain_title">등록 결과를\n확인하지 못했어요</string>
    <string name="keyring_uncertain_body">연결이 끊겨 등록이 끝났는지 아직 알 수 없어요. 인터넷 연결을 확인한 뒤 등록 상태를 다시 확인해 주세요.</string>
    <string name="keyring_check_again">등록 상태 다시 확인</string>
    <string name="keyring_failed_title">키링을\n등록하지 못했어요</string>
    <string name="keyring_failed_body">등록이 완료되지 않았어요. 키링의 전원과 등록 모드를 확인한 뒤 다시 찾아 주세요.</string>
    <string name="keyring_owned_title">다른 계정에\n등록된 키링이에요</string>
    <string name="keyring_owned_body">기존 소유자가 자신의 계정에서 실물 키링을 초기화해야 등록할 수 있어요. 키링 버튼만으로는 계정 연결이 해제되지 않아요.</string>
    <string name="keyring_unusable_title">사용할 수 없는\n키링이에요</string>
    <string name="keyring_unusable_body">영구 사용 불가 처리된 키링은 초기화해도 등록할 수 없어요. 다른 키링을 사용하거나 서비스팀에 문의해 주세요.</string>
    <string name="keyring_support">서비스팀 문의</string>
    <string name="keyring_limit_title">이미 등록한\n키링이 있어요</string>
    <string name="keyring_limit_body">현재 계정에는 키링 1개만 등록할 수 있어요. 새 키링을 등록하려면 기존 키링을 먼저 초기화해 주세요. 기존 키링을 분실했다면 서비스팀에 문의해 주세요.</string>
    <string name="keyring_manage">등록한 키링 확인</string>
    <string name="keyring_success_title">키링 등록을\n완료했어요</string>
    <string name="keyring_success_body">이 계정에 키링이 연결됐어요. 이제 프로필을 입력해 주세요. 매칭 준비는 가입 정보 입력과 설정 동기화가 끝난 뒤 완료돼요.</string>
    <string name="keyring_continue">프로필 입력하기</string>
</resources>
