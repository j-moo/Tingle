# 이 파일을 .env 로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.
# 선택 변수는 주석으로 둔다. 빈 값(KEY=)은 기본값을 덮어쓴다.
# .env 는 back/에서 실행할 때 Spring이 직접 읽는다.

# 외부 PostgreSQL 연결 (로컬 Compose·테스트 Testcontainers 사용 시 생략)
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# 로컬 개발 DB 비밀번호 (선택, 기본값 local)
# LOCAL_DB_PASSWORD=

# 서비스 액세스 토큰 서명 키. 32바이트 이상 임의 문자열 (필수, 없으면 서버가 시작되지 않는다)
JWT_SECRET=

# 소셜 로그인
# GOOGLE_WEB_CLIENT_ID=
# KAKAO_APP_ID=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 약관 전문 URL
# TERMS_CONTENT_URL=
# PRIVACY_CONTENT_URL=
# AI_RISK_CONTENT_URL=

# 채팅 알림: 미설정 시 실제 FCM 전송 비활성. ADC는 런타임만 읽는다.
# PUSH_ENABLED=true
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# PUSH_TOKEN_ENCRYPTION_KEY=<base64 encoded 32-byte AES key>
# 새 메시지 발송은 PUSH_ENABLED와 별도 opt-in. push_state 스키마·FE 계약 준비 후 함께 켠다.
# CHAT_MESSAGE_PUSH_SCHEDULING_ENABLED=true
# CHAT_MESSAGE_PUSH_POLL_MS=1000

# 선택: 구매 안내 주소. 미설정 시 null, 설정 시 사용자 인증 정보가 없는 HTTP(S) 주소를 사용한다.
# KEYRING_PURCHASE_URL=https://example.com/keyring

# 선택: 프로필 사진 저장 폴더. 미설정 시 시스템 임시 폴더(로컬 전용). 운영은 영구 볼륨 경로를 지정한다.
# PHOTO_STORAGE_DIR=

# 명시적 복원 운영 명령: java -jar app.jar chat-restore <command> --namespace=tingle_dev
# journal은 신뢰된 BE/복원 작성자 RW, restore 폴더는 일반 BE RO·복원 도구만 RW.
# 서버 폴더·권한·namespace 초기화·같은 세대·최신 저널 검증을 준비한 뒤 INFRA가 전달한다.
# 이 예시는 runtime 입력이 아니며 Compose의 별도 환경변수/마운트 전달이 필요하다.
# TINGLE_CHAT_DELETION_JOURNAL_DIRECTORY=/run/tingle/chat-journal
# TINGLE_CHAT_RESTORE_MARKER_FILE=/run/tingle/chat-restore/serving.marker
# TINGLE_CHAT_RESTORE_GENERATION=<복원 전에 새로 발급한 환경별 UUID>
# 세대 값을 넣으면 gate 검증 전 모든 요청이 차단된다. 실패 때 빈 값으로 우회하지 않는다.
