# 이 파일을 .env 로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.
# 선택 변수는 주석으로 둔다. 빈 값(KEY=)은 기본값을 덮어쓴다.
# .env 는 back/에서 실행할 때 Spring이 직접 읽는다.

# 외부 PostgreSQL 연결 (로컬 Compose·테스트 Testcontainers 사용 시 생략)
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# 로컬 개발 DB 비밀번호 (선택, 기본값 local)
# LOCAL_DB_PASSWORD=

# 서비스 액세스 토큰 서명 키. 32바이트 이상 임의 문자열 (필수, 없으면 서버가 시작되지 않는다)
JWT_SECRET=

# 소셜 로그인
# GOOGLE_WEB_CLIENT_ID=
# KAKAO_APP_ID=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 약관 전문 URL
# TERMS_CONTENT_URL=
# PRIVACY_CONTENT_URL=
# AI_RISK_CONTENT_URL=

# 아래 키링·푸시·탈퇴·백업 확인·AI·채팅 삭제 저널 값은 dev·prod 서버에서 필수다(없으면 기동 실패). 끄는 스위치는 없다.
# local 프로필은 application-local.yml 의 시험용 값을 쓰므로 비워 둬도 된다. 실제 키를 쓰려면 아래 값을 넣는다.

# 채팅 알림(FCM). local 은 보내지 않는 게이트웨이를 쓴다.
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# PUSH_TOKEN_ENCRYPTION_KEY=<base64 encoded 32-byte AES key>
# CHAT_MESSAGE_PUSH_POLL_MS=1000

# AI 서버 호출(서비스 토큰)과 AI 시작 질문 릴리스. local 은 비우면 AI 요청이 대기한다.
# APP_AI_SERVICE_ENVIRONMENT=dev
# APP_AI_SERVICE_BASE_URL=http://ai-dev:8000
# APP_AI_SERVICE_KEY_ID=
# APP_AI_SERVICE_PRIVATE_KEY_FILE=
# APP_ICEBREAKER_MANIFEST_LOCATION=file:/run/tingle/<release>/be-descriptor.json

# 선택: 구매 안내 주소. 미설정 시 null, 설정 시 사용자 인증 정보가 없는 HTTP(S) 주소를 사용한다.
# KEYRING_PURCHASE_URL=https://example.com/keyring

# 키링 설정 서명 키(Ed25519 PEM)와 TSV3 정책 값. 공개키 hex 는 서명 키의 공개키와 같아야 한다.
# KEYRING_DEV_SETTINGS_PRIVATE_KEY_FILE=
# KEYRING_DEV_SETTINGS_PUBLIC_KEY_FILE=
# KEYRING_DEV_SETTINGS_PROFILE_DEVICE_SERIALS=
# KEYRING_PEER_POLICY_VERSION=1380991793
# KEYRING_PEER_RULE_VERSION=268439809
# KEYRING_PEER_LEASE_SECONDS=
# KEYRING_PEER_OPPORTUNITY_SECONDS=
# KEYRING_PEER_PRESENCE_GAP_SECONDS=
# KEYRING_PEER_SERVER_PUBLIC_KEY_HEX=

# 선택: 프로필 사진 저장 폴더. 미설정 시 시스템 임시 폴더(로컬 전용). 운영은 영구 볼륨 경로를 지정한다.
# PHOTO_STORAGE_DIR=

# 회원탈퇴 전용 비밀키(각 32바이트 이상). JWT_SECRET과 분리한다.
# 72시간 영수증과 1년 관계 기록이 남아 있는 동안 무계획 교체 금지.
# WITHDRAWAL_IDENTITY_SECRET=
# WITHDRAWAL_RECEIPT_SECRET=

# 채팅 삭제 전 백업 확인(docs/specifications/functional-spec-v3/backup-evidence-v1.md). 증거 파일이 없으면 삭제를 보류한다.
# APP_BACKUP_EVIDENCE_FILE=
# APP_BACKUP_EVIDENCE_GENERATION_FILE=
# APP_BACKUP_EVIDENCE_NAMESPACE=tingle_dev
# APP_BACKUP_EVIDENCE_SCOPE_ID=
# APP_BACKUP_EVIDENCE_APPROVAL_ID=

# 채팅 삭제 의도 기록(저널) 폴더. dev·prod 필수(서버 앱도 읽는다). DB 복원과 분리된 영구 볼륨이며 환경마다 따로 둔다.
# 처음 한 번 java -jar app.jar chat-restore journal-init --namespace=<tingle|tingle_dev> 로 만든다. 만들기 전에는 삭제가 보류된다.
# local 은 비우면 임시 폴더를 쓴다(삭제 보류).
# TINGLE_CHAT_DELETION_JOURNAL_DIRECTORY=/run/tingle/chat-journal
# 명시적 복원 운영 명령: java -jar app.jar chat-restore <command> --namespace=tingle_dev
# restore 폴더는 일반 BE RO·복원 도구만 RW. 같은 세대·최신 저널 검증을 준비한 뒤 INFRA가 전달한다.
# TINGLE_CHAT_RESTORE_MARKER_FILE=/run/tingle/chat-restore/serving.marker
# TINGLE_CHAT_RESTORE_GENERATION=<복원 전에 새로 발급한 환경별 UUID>
# 세대 값을 넣으면 gate 검증 전 모든 요청이 차단된다. 실패 때 빈 값으로 우회하지 않는다.
