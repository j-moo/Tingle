# 이 파일을 .env 로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.
# 선택 변수는 주석으로 둔다. 빈 값(KEY=)은 기본값을 덮어쓴다.
# .env 는 back/에서 실행할 때 Spring이 직접 읽는다.

# 외부 PostgreSQL 연결 (로컬 Compose·테스트 Testcontainers 사용 시 생략)
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# 로컬 개발 DB 비밀번호 (선택, 기본값 local)
# LOCAL_DB_PASSWORD=

# 서비스 액세스 토큰 서명 키. 32바이트 이상 임의 문자열 (필수, 없으면 서버가 시작되지 않는다)
JWT_SECRET=

# 소셜 로그인
# GOOGLE_WEB_CLIENT_ID=
# KAKAO_APP_ID=

# 약관 전문 URL
# TERMS_CONTENT_URL=
# PRIVACY_CONTENT_URL=
# AI_RISK_CONTENT_URL=
