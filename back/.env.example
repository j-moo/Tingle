# 이 파일을 .env 로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.
# 선택 변수는 주석으로 둔다. 빈 값(KEY=)은 기본값을 덮어쓴다.
# .env 는 back/에서 실행할 때 Spring이 직접 읽는다.

# 외부 PostgreSQL 연결 (로컬 Compose·테스트 Testcontainers 사용 시 생략)
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# 로컬 개발 DB 비밀번호 (선택, 기본값 local)
# LOCAL_DB_PASSWORD=

# 서비스 액세스 토큰 서명 키. 32바이트 이상 임의 문자열 (필수, 없으면 서버가 시작되지 않는다)
JWT_SECRET=

# 푸시 전달 토큰 저장용 AES-256 키. JWT와 별도로 생성한 32바이트를 Base64로 인코딩한다.
# 누락 시 푸시 등록은 503으로 거부한다. 실제 값은 커밋하지 않는다.
# PUSH_TOKEN_ENCRYPTION_KEY=

# 소셜 로그인
# GOOGLE_WEB_CLIENT_ID=
# KAKAO_APP_ID=

# 약관 전문 URL
# TERMS_CONTENT_URL=
# PRIVACY_CONTENT_URL=
# AI_RISK_CONTENT_URL=
# 선택: 구매 안내 주소. 미설정 시 null, 설정 시 사용자 인증 정보가 없는 HTTP(S) 주소를 사용한다.
# KEYRING_PURCHASE_URL=https://example.com/keyring
