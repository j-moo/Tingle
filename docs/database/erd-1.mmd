erDiagram
    app_users {
        bigint user_id PK
        text provider
        text provider_subject
        text status
        timestamptz created_at
        timestamptz signup_completed_at
    }
    refresh_tokens {
        bigint token_id PK
        bigint user_id
        uuid family_id
        bytea token_hash
        timestamptz expires_at
        timestamptz used_at
        timestamptz revoked_at
    }
    user_consents {
        bigint consent_id PK
        bigint user_id
        text consent_type
        text document_version
        boolean agreed
        timestamptz recorded_at
    }
    profiles {
        bigint user_id PK
        text nickname
        text nickname_key
        date birth_date
        text gender
        text smoking_status
        text drinking_frequency
        text religion
        text introduction
        text image_url
        timestamptz completed_at
    }
    matching_settings {
        bigint user_id PK
        text_array desired_genders
        integer age_min
        integer age_max
        boolean matching_enabled
        boolean require_partner_photo
        bigint settings_version
    }
    app_users ||--o{ refresh_tokens : "user_id logical"
